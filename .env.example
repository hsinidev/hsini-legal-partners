# =========================================================================
# Hsini Legal Partners - Phase 2 Environment Configuration Template
# Copy this file to '.env.local' for local development
# =========================================================================

# 1. Secure Email Provider Integration (Resend or SendGrid)
# Obtain your key at https://resend.com
RESEND_API_KEY=re_your_secure_resend_api_key_here

# 2. Sanity.io Headless CMS Integration
# Obtain these values from your Sanity Dashboard (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Required for preview or draft mode publications
SANITY_API_TOKEN=sk_your_secure_sanity_write_or_read_token

# 3. Security Covenants
# Used to verify intake dispatch rate limits locally if not deploying to Vercel
# Optional; if not defined, the rate limiter uses a fallback mock client IP buffer.
RATE_LIMIT_MAX_PER_HOUR=5
